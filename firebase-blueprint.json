{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile containing settings like birth date for the timeline.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "birthDate": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["email", "createdAt", "updatedAt"]
    },
    "Goal": {
      "title": "Goal",
      "description": "A user's goal",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "status": { "type": "string" },
        "targetDate": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "title", "category", "status", "createdAt", "updatedAt"]
    },
    "Event": {
      "title": "Event",
      "description": "A user's calendar event",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "title", "createdAt", "updatedAt"]
    },
    "Reflection": {
      "title": "Reflection",
      "description": "A user's daily reflection",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "text": { "type": "string" },
        "date": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "text", "date", "createdAt", "updatedAt"]
    },
    "Quote": {
      "title": "Quote",
      "description": "A user's saved quote",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "text": { "type": "string" },
        "author": { "type": "string" },
        "savedAt": { "type": "string" }
      },
      "required": ["userId", "text", "savedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles"
    },
    "/goals/{goalId}": {
      "schema": { "$ref": "#/entities/Goal" },
      "description": "User goals"
    },
    "/events/{eventId}": {
      "schema": { "$ref": "#/entities/Event" },
      "description": "User events"
    },
    "/reflections/{reflectionId}": {
      "schema": { "$ref": "#/entities/Reflection" },
      "description": "User daily reflections"
    },
    "/quotes/{quoteId}": {
      "schema": { "$ref": "#/entities/Quote" },
      "description": "User saved quotes"
    }
  }
}
